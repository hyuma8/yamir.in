---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Yamir Packaging" description="That page does not exist." noEnquiry>
  <section class="section">
    <div class="wrap">
      <h1>That page is not here</h1>
      <p class="lead">The link may be old. Try the products page or contact us directly.</p>
      <div class="cluster">
        <a class="btn btn--outline" href="/products">Products</a>
        <a class="btn btn--accent" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
