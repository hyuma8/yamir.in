---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Plate from '../../components/Plate.astro';
import Needs from '../../components/Needs.astro';
import { plants, company, isNeeds } from '../../data/site';
export function getStaticPaths() { return plants.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': `${company.domain}/plants/${p.slug}`, name: `${company.name}, ${p.name} plant`,
  parentOrganization: { '@type': 'Organization', name: company.name, url: company.domain }, image: `${company.domain}/images/yamir-logo.png`, telephone: company.phone.replace(/\s/g, ''),
  address: { '@type': 'PostalAddress', streetAddress: isNeeds(p.address) ? '' : p.address, addressLocality: p.city, addressRegion: 'Gujarat', addressCountry: 'IN' } };
---
<Base title={`${p.name} Plant — Yamir Packaging, Gujarat`} description={`Yamir Packaging's ${p.name} plant, ${p.locality}. Address, what it makes, capacity and key machines.`} schema={[schema]}>
  <section class="m sec--top">
    <Crumbs items={[{ label: 'Plants', href: '/plants' }, { label: p.name }]} />
    <h1 style="margin-top:3rem">{p.name}</h1>
    <p class="lead" style="margin:1.6rem 0 3rem">{p.locality}. {p.short}</p>
    <Plate id={`plant-${p.slug}-ext`} />
  </section>
  <section class="m sec two">
    <div>
      <span class="lbl">The plant</span>
      <div class="ledger" style="margin-top:1rem">
        <div><b>Address</b><span><Needs text={p.address} /></span><a class="lnk" href={isNeeds(p.mapsUrl) ? '#' : p.mapsUrl} rel="noopener">Map</a></div>
        <div><b>Makes</b><span><Needs text={p.makes} /></span><i></i></div>
        <div><b>Capacity</b><span><Needs text={p.capacity} /></span><i></i></div>
        <div><b>Built-up area</b><span><Needs text={p.area} /></span><i></i></div>
        <div><b>People</b><span><Needs text={p.people} /></span><i></i></div>
        <div><b>Since</b><span><Needs text={p.since} /></span><i></i></div>
      </div>
      <span class="lbl" style="display:block;margin-top:2.5rem">Key machines</span>
      <ul class="list">{p.machines.map((m) => <li><Needs text={m} /></li>)}</ul>
      <p class="lbl" style="margin-top:2.5rem">Other plants: {plants.filter((x) => x.slug !== p.slug).map((x, i) => <Fragment>{i > 0 && ' · '}<a href={`/plants/${x.slug}`} style="border-bottom:1px solid var(--hair-2)">{x.name}</a></Fragment>)}</p>
    </div>
    <Plate id={`plant-${p.slug}-int`} />
  </section>
</Base>
<style>
  .list { margin-top: .6rem; }
  .list li { padding: .7rem 0; border-bottom: 1px solid var(--hair); }
</style>
