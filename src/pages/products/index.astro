---
// GOAL: buyer finds the carton type they need in one scan and clicks through.
// PRIMARY KEYWORD: "folding carton manufacturer India" (to confirm)
// ONE ACTION: open a product page (secondary: send enquiry).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { products } from '../../data/site';
---
<BaseLayout
  title="Products — Folding Cartons, Liner, Window, Foil, Blister Cards | Yamir"
  description="Mono cartons, liner cartons, micro-flute corrugated, window cartons, foil and Metpet cartons, blister cards and pharma cartons. Made at Yamir's three Gujarat plants."
>
  <Breadcrumbs items={[{ label: 'Products' }]} />
  <section class="section" style="padding-top:2rem">
    <div class="wrap">
      <h1>Products</h1>
      <p class="lead">Every carton type below is printed and converted in-house at our Gujarat plants. Pick the one closest to your need; we build to your spec from there.</p>
      <div class="grid grid--3" style="margin-top:2rem">
        {products.map((p) => (
          <a class="card card-block" href={`/products/${p.slug}`}>
            <h3>{p.name}</h3>
            <p class="muted">{p.short}</p>
            <p class="small muted" style="margin:0">Best for: {p.bestFor.join(', ')}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
