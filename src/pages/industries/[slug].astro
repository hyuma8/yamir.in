---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Plate from '../../components/Plate.astro';
import Needs from '../../components/Needs.astro';
import { industries, cartons } from '../../data/site';
export function getStaticPaths() { return industries.map((i) => ({ params: { slug: i.slug }, props: { i } })); }
const { i } = Astro.props;
const related = cartons.filter((c) => i.cartonSlugs.includes(c.slug));
---
<Base title={`${i.name} Packaging — Folding Cartons | Yamir Packaging`} description={i.answer.slice(0, 155)}>
  <section class="m sec--top">
    <Crumbs items={[{ label: 'Industries', href: '/industries' }, { label: i.name }]} />
    <div class="two" style="margin-top:3rem;align-items:end">
      <div><h1>{i.name}</h1><p class="lead" style="margin-top:1.6rem">{i.answer}</p></div>
      <Plate id={`ind-${i.slug}`} />
    </div>
  </section>
  <section class="m sec two two--even" style="border-top:1px solid var(--hair)">
    <div><span class="lbl">What {i.name} buyers need</span><ul class="list">{i.needs.map((n) => <li>{n}</li>)}</ul></div>
    <div><span class="lbl">How we meet it</span><ul class="list">{i.how.map((h) => <li><Needs text={h} /></li>)}</ul></div>
  </section>
  <section class="m sec" style="border-top:1px solid var(--hair)">
    <span class="lbl">Cartons for {i.name}</span>
    <ul class="coll" style="margin-top:1rem">{related.map((c) => <li><a href={`/cartons/${c.slug}`}><span class="n">{c.name}</span><span class="d">{c.d}</span></a></li>)}</ul>
  </section>
</Base>
<style>
  .list { margin-top: .6rem; }
  .list li { font-family: var(--serif); font-size: 1.4rem; font-weight: 400; padding: .7rem 0; border-bottom: 1px solid var(--hair); }
</style>
