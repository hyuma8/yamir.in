---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Plate from '../components/Plate.astro';
import Needs from '../components/Needs.astro';
import { certifications, NEEDS } from '../data/site';
const steps = [
  { s: 'Incoming board', w: NEEDS('tests on incoming board: GSM, caliper, moisture') },
  { s: 'Prepress', w: NEEDS('artwork check and colour proofing process') },
  { s: 'On press', w: NEEDS('colour control: spectrophotometer, press-side checks') },
  { s: 'Converting', w: NEEDS('die-cut and gluing checks') },
  { s: 'Final inspection', w: NEEDS('camera inspection, sampling plan, release criteria') },
  { s: 'Traceability', w: NEEDS('batch records kept for how long; COA offered?') },
];
---
<Base title="Quality and Certifications — ISO 9001, FSSC 22000, FSC | Yamir" description="Yamir Packaging is certified to ISO 9001, ISO 14001, ISO 45001, FSSC 22000 V6, SEDEX and FSC, with an EcoVadis Bronze medal. The certificates, and the checks made on every job.">
  <section class="m sec--top">
    <Crumbs items={[{ label: 'Quality' }]} />
    <h1 style="margin-top:3rem">Quality you can audit.</h1>
    <p class="lead" style="margin-top:1.6rem">Each certificate below is a document you can download and file. Below them, the checks we make on every job.</p>
  </section>
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <div><span class="lbl">Certifications</span><p class="prose" style="margin-top:1rem"><Needs text={NEEDS('confirm which plants each certificate covers')} /></p></div>
    <div class="ledger">{certifications.map((c) => <div><b>{c.code}</b><span>{c.label}</span><a class="lnk" href="#">{c.doc}</a></div>)}</div>
  </section>
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <div><span class="lbl">On every job</span><h2 style="margin-top:1rem">Six checks, in order.</h2><Plate id="qc-lab" class="pl" /></div>
    <ol class="steps">{steps.map((x) => <li><div><b>{x.s}</b><span><Needs text={x.w} /></span></div></li>)}</ol>
  </section>
</Base>
<style>.pl { margin-top: 2.5rem; }</style>
