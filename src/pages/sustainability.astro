---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Plate from '../components/Plate.astro';
import Needs from '../components/Needs.astro';
import { NEEDS } from '../data/site';
---
<Base title="Sustainability — FSC, ISO 14001, EcoVadis Bronze | Yamir Packaging" description="Yamir Packaging holds an EcoVadis Bronze medal, FSC chain of custody and ISO 14001. What we measure, what we have changed, and what we offer brands.">
  <section class="m sec--top two" style="align-items:end">
    <div>
      <Crumbs items={[{ label: 'Sustainability' }]} />
      <h1 style="margin-top:3rem">Sustainability, with the paperwork.</h1>
      <p class="lead" style="margin-top:1.6rem">Paperboard is recyclable and comes from a renewable source. We back that with ratings and certificates your team can file.</p>
    </div>
    <Plate id="sus-board" />
  </section>
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <span class="lbl">Third-party</span>
    <div class="ledger">
      <div><b>EcoVadis Bronze</b><span><Needs text={NEEDS('year awarded')} /></span><a class="lnk" href="#">Scorecard on request</a></div>
      <div><b>FSC®</b><span>Certified board on request, with chain-of-custody documents. Licence <Needs text={NEEDS('FSC licence code')} /></span><i></i></div>
      <div><b>ISO 14001 : 2015</b><span>Environmental management system. <Needs text={NEEDS('plants covered')} /></span><a class="lnk" href="#">Certificate PDF</a></div>
    </div>
  </section>
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <div><span class="lbl">Measured</span><h2 style="margin-top:1rem">What we measure, what has changed.</h2><p class="prose" style="margin-top:1rem">Only real, measured figures go here: a number, a year, a source.</p><Plate id="sus-waste" class="pl" /></div>
    <ul class="list">
      <li><Needs text={NEEDS('energy: rooftop solar kW, share of consumption')} /></li>
      <li><Needs text={NEEDS('waste: share of board waste recycled')} /></li>
      <li><Needs text={NEEDS('inks and coatings: low-migration or water-based policy')} /></li>
      <li><Needs text={NEEDS('water: treatment or reuse at plants')} /></li>
    </ul>
  </section>
</Base>
<style>
  .pl { margin-top: 2.5rem; }
  .list li { padding: .9rem 0; border-bottom: 1px solid var(--hair); }
  .list li:first-child { border-top: 1px solid var(--hair); }
</style>
