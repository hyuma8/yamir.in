---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Plate from '../components/Plate.astro';
import Needs from '../components/Needs.astro';
import { company, NEEDS } from '../data/site';
const milestones = [
  [NEEDS('year'), NEEDS('first press, company founded')],
  [NEEDS('year'), NEEDS('Yamir Packaging Pvt. Ltd. incorporated')],
  [NEEDS('year'), NEEDS('Kadi plant')], [NEEDS('year'), NEEDS('Bharuch plant')], [NEEDS('year'), NEEDS('Mandva plant')],
  ['2026', 'Hyuma Mahadevia becomes Managing Director.'],
];
---
<Base title="About Yamir Packaging — Family-run Carton Manufacturer, Gujarat" description="Yamir Packaging is a family-run folding carton company with three plants in Gujarat. Who we are, how we are led, and how we work.">
  <section class="m sec--top">
    <Crumbs items={[{ label: 'About' }]} />
    <div class="two" style="margin-top:3rem;align-items:end">
      <div><h1>A family firm, in its second generation.</h1><p class="lead" style="margin-top:1.6rem">{company.shortName} has made printed paperboard packaging since <Needs text={company.foundedYear} />. It is led by Hyuma Mahadevia, who joined in 2000 and became Managing Director in 2026.</p></div>
      <Plate id="about-hyuma" />
    </div>
  </section>
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <span class="lbl">In his words</span>
    <p class="quote"><Needs text={NEEDS('three or four sentences from Hyuma on what the company stands for: quality, people, long relationships. Plain and specific.')} /></p>
  </section>
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <span class="lbl">Milestones</span>
    <div class="ledger">{milestones.map(([y, w]) => <div><b><Needs text={y} /></b><span><Needs text={w} /></span><i></i></div>)}</div>
  </section>
  <section class="m sec" style="border-top:1px solid var(--hair)">
    <span class="lbl">Leadership</span>
    <div class="people">
      <div><Plate id="about-portrait-md" /><h3>Hyuma Mahadevia</h3><span class="lbl">Managing Director</span><p class="prose small">With Yamir since 2000. Oversees production, quality, procurement and HR across all plants. IIM Ahmedabad alumnus.</p></div>
      <div><Plate id="about-portrait-2" /><h3><Needs text={NEEDS('name')} /></h3><span class="lbl"><Needs text={NEEDS('role')} /></span><p class="prose small"><Needs text={NEEDS('two lines')} /></p></div>
      <div><Plate id="about-portrait-3" /><h3><Needs text={NEEDS('name')} /></h3><span class="lbl"><Needs text={NEEDS('role')} /></span><p class="prose small"><Needs text={NEEDS('two lines')} /></p></div>
    </div>
  </section>
  <section class="m" style="padding-bottom:var(--sec)"><Plate id="about-team" /></section>
</Base>
<style>
  .quote { font-family: var(--serif); font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.35; font-weight: 300; }
  .people { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; margin-top: 1.5rem; }
  .people h3 { margin-top: 1.4rem; }
  .people .lbl { display: block; margin: .4rem 0 .8rem; }
  .small { font-size: .95rem; }
  @media (max-width: 900px) { .people { grid-template-columns: 1fr; } }
</style>
