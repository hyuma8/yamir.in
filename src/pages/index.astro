---
// GOAL: a B2B buyer understands in 10 seconds what we make, where, and that we
// are certified — then sends an enquiry.
// READER: purchase head / packaging development manager / brand owner.
// PRIMARY KEYWORD: "paperboard packaging manufacturer Gujarat" (to confirm with keyword research)
// ONE ACTION: Send enquiry.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import { products, industries, plants, certifications, faqsGeneral } from '../data/site';
---
<BaseLayout
  title="Yamir Packaging — Paperboard Carton Manufacturer, Gujarat"
  description="Printed folding cartons for FMCG, pharma and food brands. Three plants in Gujarat (Kadi, Bharuch, Mandva). ISO 9001, FSSC 22000, FSC certified. Send an enquiry."
>
  <!-- HERO: one message, one action -->
  <section class="section hero">
    <div class="wrap hero__grid">
      <div>
        <h1>Printed paperboard cartons from three plants in Gujarat.</h1>
        <p class="lead">Yamir Packaging makes folding cartons for FMCG, pharma and food brands from three plants in Kadi, Bharuch and Mandva. Certified to ISO 9001, FSSC 22000 and FSC.</p>
        <div class="cluster">
          <a class="btn btn--accent" href="/contact">Send enquiry</a>
          <a class="btn btn--outline" href="/products">See products</a>
        </div>
      </div>
      <Photo shot="Finished cartons stacked on a pallet at the end of a folder-gluer line, natural light, no people looking at camera" />
    </div>
  </section>

  <ProofBar />

  <!-- PRODUCTS -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we make</p>
      <h2>Folding cartons and cards for retail, pharma and food</h2>
      <div class="grid grid--3">
        {products.map((p) => (
          <a class="card card-block" href={`/products/${p.slug}`}>
            <h3>{p.name}</h3>
            <p class="muted">{p.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Who we serve</p>
      <h2>Built for buyers who cannot afford a packaging failure</h2>
      <div class="grid grid--3">
        {industries.map((i) => (
          <a class="card card-block" href={`/industries/${i.slug}`}>
            <h3>{i.name}</h3>
            <p class="muted">{i.answer}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PLANTS -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Where we make it</p>
      <h2>Three plants in Gujarat</h2>
      <p class="lead">Kadi is near Ahmedabad. Bharuch and Mandva are in South Gujarat on the Ahmedabad–Mumbai highway. Each plant has its own page with address, capacity and machines.</p>
      <div class="grid grid--3">
        {plants.map((p) => (
          <a class="card card-block" href={`/plants/${p.slug}`}>
            <Photo shot={`Exterior of the ${p.name}, morning light`} />
            <h3 style="margin-top:1rem">{p.name}</h3>
            <p class="muted">{p.locality}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="section section--primary">
    <div class="wrap">
      <p class="eyebrow" style="color:var(--on-primary-soft)">Proof, not promises</p>
      <h2>Certified where it matters to your auditors</h2>
      <ul class="certs">
        {certifications.map((c) => (
          <li><strong>{c.code}</strong><span class="muted">{c.label}</span></li>
        ))}
      </ul>
      <a class="btn btn--outline" href="/quality">How we control quality</a>
    </div>
  </section>

  <Faq items={faqsGeneral} />
</BaseLayout>

<style>
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 860px) { .hero__grid { grid-template-columns: 1.1fr 1fr; gap: 4rem; } }
  .hero h1 { margin-bottom: 1rem; }
  .hero .cluster { margin-top: 1.5rem; }
  .certs { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .certs li { display: flex; flex-direction: column; padding: 1rem; border: 1px solid rgba(255,255,255,0.18); border-radius: var(--radius); }
  .certs strong { color: #fff; font-size: 1.05rem; }
</style>
