---
// HOME. Goal: a buyer feels in ten seconds that this is a serious carton maker,
// and finds the enquiry. Primary keyword: folding carton manufacturer Gujarat.
import Base from '../layouts/Base.astro';
import Carton from '../components/Carton.astro';
import Dieline from '../components/Dieline.astro';
import Plate from '../components/Plate.astro';
import Faq from '../components/Faq.astro';
import { cartons, plants, certifications, faqsGeneral } from '../data/site';
---
<Base
  title="Yamir Packaging — Folding Carton Manufacturer, Gujarat"
  description="Folding cartons for FMCG, pharma and food brands, made in three plants in Gujarat: Kadi, Bharuch and Mandva. ISO 9001, FSSC 22000, FSC, EcoVadis Bronze."
>
  <!-- Hero: pinned for one screen; the carton turns as you scroll -->
  <div class="hero">
    <div class="pin m">
      <i class="mark tl"></i><i class="mark tr"></i><i class="mark bl"></i><i class="mark br"></i>
      <div class="copy">
        <span class="lbl">Paperboard cartons · Gujarat, India</span>
        <h1>Board.<br>Ink.<br>Crease.<br>Fold.</h1>
        <p class="lead">Folding cartons for FMCG, pharma and food brands, made from the first sheet to the last glue line in our own three plants.</p>
        <div class="cta"><a class="btn" href="/enquire">Send an enquiry</a><a class="lnk" href="/cartons">Carton styles</a></div>
      </div>
      <Carton />
      <div class="foot"><span class="lbl">Scroll to turn</span><span class="lbl">Kadi · Bharuch · Mandva</span></div>
    </div>
  </div>

  <!-- Statement -->
  <section class="statement m">
    <p>Three plants in Gujarat, one way of working: the colour right, the board right, the carton where it should be on the day it was promised.</p>
    <div class="facts">{certifications.map((c) => <span>{c.code}</span>)}</div>
  </section>

  <!-- The plant photograph -->
  <section class="m" style="padding-bottom:var(--sec)">
    <Plate id="home-plant" />
  </section>

  <!-- Carton styles -->
  <section class="m sec two--rev two">
    <div>
      <div class="head"><span class="lbl">Carton styles</span><a class="lnk" href="/cartons">All styles</a></div>
      <ul class="coll">{cartons.map((c) => <li><a href={`/cartons/${c.slug}`}><span class="n">{c.name}</span><span class="d">{c.d}</span></a></li>)}</ul>
    </div>
    <div class="side">
      <Dieline kind="ste" large />
      <div class="cap"><span class="lbl">Straight tuck end</span><span class="lbl">Cut — Crease ⋯</span></div>
    </div>
  </section>

  <!-- Plants -->
  <section class="m sec two" style="border-top:1px solid var(--hair)">
    <div>
      <h2>Three plants, one highway.</h2>
      <p class="prose" style="margin-top:1.4rem">Kadi serves Ahmedabad and North Gujarat. Bharuch and Mandva sit in the pharma and chemical belt of South Gujarat, on the Ahmedabad–Mumbai highway. You are welcome at any of them before you place an order.</p>
      <a class="lnk" href="/plants" style="display:inline-block;margin-top:2rem">The plants</a>
    </div>
    <div class="three">{plants.map((p) => <div><b><a href={`/plants/${p.slug}`}>{p.name}</a></b><span>{p.locality}</span></div>)}</div>
  </section>

  <Faq items={faqsGeneral} />
</Base>

<style>
  .hero { position: relative; height: 200vh; background: radial-gradient(110% 80% at 72% 25%, #fdfcfa 0%, var(--paper) 50%, #efebe3 100%); }
  .pin { position: sticky; top: 0; height: 100vh; display: grid; grid-template-columns: 5fr 7fr; align-items: center; }
  .copy { padding-top: 96px; position: relative; z-index: 2; }
  .copy .lbl { display: block; margin-bottom: 1.6rem; }
  .copy .lead { margin: 1.8rem 0 2.4rem; max-width: 30ch; }
  .cta { display: flex; align-items: center; gap: 2.2rem; }
  .foot { position: absolute; left: var(--m); right: var(--m); bottom: 2rem; display: flex; justify-content: space-between; z-index: 2; }
  .mark { position: absolute; width: 22px; height: 22px; pointer-events: none; opacity: .6; }
  .mark::before, .mark::after { content: ''; position: absolute; background: var(--hair-2); }
  .mark::before { width: 22px; height: 1px; top: 11px; } .mark::after { height: 22px; width: 1px; left: 11px; }
  .mark.tl { left: 1.2rem; top: 7rem; } .mark.tr { right: 1.2rem; top: 7rem; } .mark.bl { left: 1.2rem; bottom: 1.2rem; } .mark.br { right: 1.2rem; bottom: 1.2rem; }

  .statement { padding-top: calc(var(--sec) + 2rem); padding-bottom: var(--sec); display: grid; grid-template-columns: 2fr 8fr 2fr; }
  .statement p { grid-column: 2; font-family: var(--serif); font-size: clamp(1.7rem, 2.9vw, 2.6rem); line-height: 1.3; font-weight: 300; text-align: center; text-wrap: balance; }
  .statement .facts { grid-column: 2; display: flex; justify-content: center; gap: 1rem 3rem; margin-top: 3.5rem; flex-wrap: wrap; }
  .statement .facts span { font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--soft); }

  .head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 1.2rem; }
  .side { position: sticky; top: 7rem; padding-top: 2.6rem; }
  .side .cap { display: flex; justify-content: space-between; margin-top: 1.2rem; }

  @media (max-width: 900px) {
    .hero { height: auto; } .pin { position: static; height: auto; grid-template-columns: 1fr; padding-top: 80px; }
    .foot, .mark { display: none; }
    .statement { grid-template-columns: 1fr; } .statement p, .statement .facts { grid-column: 1; }
    .side { display: none; }
  }
</style>
