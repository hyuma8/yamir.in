---
import { nav, company } from '../data/site';
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr m">
  <a href="/" class="logo" aria-label={`${company.name}, home`}><img src="/images/yamir-logo.svg" alt="" width="118" height="46" /></a>
  <nav class="nav" aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
    <a href="/enquire" class="enq">Enquire</a>
  </nav>
  <details class="menu">
    <summary aria-label="Menu"><span>Menu</span></summary>
    <nav aria-label="Main, mobile">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/enquire">Enquire</a>
      <a href={company.phoneHref}>{company.phone}</a>
    </nav>
  </details>
</header>

<style>
  .hdr { position: absolute; top: 0; left: 0; right: 0; z-index: 6; display: flex; align-items: center; justify-content: space-between; height: 96px; }
  .logo img { width: 118px; height: auto; }
  .nav { display: flex; gap: 2.2rem; }
  .nav a { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; padding-bottom: .3rem; border-bottom: 1px solid transparent; }
  .nav a:hover { color: var(--soft); }
  .nav a[aria-current='page'] { border-color: var(--ink); }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; padding: .5rem 0; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav { position: absolute; right: 0; top: 2.6rem; background: var(--paper); border: 1px solid var(--hair); min-width: 220px; padding: .6rem 0; display: grid; }
  .menu nav a { padding: .7rem 1.2rem; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; }
  .menu nav a:hover { background: var(--paper-2); }
  @media (max-width: 900px) { .nav { display: none; } .menu { display: block; } .hdr { height: 80px; } }
</style>
