---
import Needs from './Needs.astro';
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions buyers ask' } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
{items.length > 0 && (
  <section class="m sec two">
    <div><span class="lbl">Questions</span><h2 style="margin-top:1rem">{title}</h2></div>
    <div class="faq">{items.map((f) => <details><summary>{f.q}</summary><p><Needs text={f.a} /></p></details>)}</div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}
