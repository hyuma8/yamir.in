---
import { company, nav, plants, certifications } from '../data/site';
import Needs from './Needs.astro';
---
<footer class="ftr m">
  <div class="grid">
    <div>
      <img src="/images/yamir-logo.svg" alt={company.name} width="110" height="43" />
      <p class="small">{company.description}</p>
      <p class="small"><span class="lbl">Registered office</span><br /><Needs text={company.registeredOffice} /></p>
    </div>
    <div>
      <span class="lbl">Plants</span>
      <ul>{plants.map((p) => <li><a href={`/plants/${p.slug}`}>{p.name}</a> <span class="small">{p.district} district</span></li>)}</ul>
    </div>
    <div>
      <span class="lbl">Site</span>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/enquire">Enquire</a></li></ul>
    </div>
    <div>
      <span class="lbl">Contact</span>
      <ul>
        <li><a href={company.phoneHref}>{company.phone}</a></li>
        <li><a href={company.whatsappHref} rel="noopener">WhatsApp</a></li>
        <li><a href={company.emailHref}>{company.email}</a></li>
        <li><a href={company.linkedin} rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
  </div>
  <div class="base">
    <span>{certifications.map((c) => c.code).join('  ·  ')}</span>
    <span>© {new Date().getFullYear()} {company.name}</span>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--hair); padding-top: 4rem; padding-bottom: 3rem; }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; }
  .grid img { margin-bottom: 1.2rem; }
  .grid ul li { margin-top: .5rem; }
  .grid .lbl { display: block; margin-bottom: .4rem; }
  .small { font-size: .88rem; color: var(--soft); max-width: 38ch; margin-top: .6rem; }
  .base { margin-top: 3.5rem; padding-top: 1.4rem; border-top: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
